# =============================================================================
# CDK16 Analysis Workbench - Environment Configuration Example
# Copy this file to .env or .env.local for local overrides.
# =============================================================================

# Server Binding
HOST=127.0.0.1
PORT=8000

# Data Directories (Defaults point to repository structure)
# CDK16_DATA_DIR=./data/processed
# CDK16_RESULTS_DIR=./results

# Execution Mode
# Set CDK16_SYNC=1 in serverless / Vercel environments where background threads
# may be terminated when the request finishes. In standard server mode, leave unset
# or set to 0 for non-blocking asynchronous analysis worker threads.
CDK16_SYNC=0
